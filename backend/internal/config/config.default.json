{
	"server": {
		"read_timeout": "10s",
		"write_timeout": "10s",
		"idle_timeout": "2m"
	},
	"database": {
		"busy_timeout": "5s",
		"wal": true
	},
	"logger": {
		"level": "info",
		"json": true,
		"add_source": false,
		"collector": {
			"enabled": true,
			"max_spans": 10000,
			"trace_header": "X-Trace-Id"
		}
	}
}
