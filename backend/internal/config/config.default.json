{
	"server": {
		"read_timeout": "10s",
		"write_timeout": "10s",
		"idle_timeout": "2m"
	},
	"database": {
		"busy_timeout": "5s",
		"wal": true
	},
	"logging": {
		"level": 0,
		"json": true,
		"add_source": false,
		"collector": {
			"enabled": true,
			"max_spans": 10000,
			"trace_header": "X-Trace-Id"
		}
	},
	"push": {
		"allowed_hosts": [
			"fcm.googleapis.com",
			"updates.push.services.mozilla.com",
			"wns.windows.com",
			"push.apple.com"
		]
	}
}
