meta {
  name: Get Registration Token
  type: http
  seq: 2
}

get {
  url: {{scheme}}{{host}}/api/admin/registration-codes
  body: none
  auth: inherit
}

script:post-response {
  if (res.body.error) {
    bru.setEnvVar("registration_code", "")
  } else {
    const code = res.body.code;
  bru.setEnvVar("registration_code", code)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
