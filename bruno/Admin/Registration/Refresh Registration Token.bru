meta {
  name: Refresh Registration Token
  type: http
  seq: 1
}

post {
  url: {{scheme}}{{host}}/api/admin/registration-codes
  body: none
  auth: inherit
}

script:post-response {
  const code = res.body.code;
  bru.setEnvVar("registrationCode", code)
}

settings {
  encodeUrl: true
  timeout: 0
}
