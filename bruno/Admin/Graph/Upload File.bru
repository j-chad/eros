meta {
  name: Upload File
  type: http
  seq: 6
}

put {
  url: {{scheme}}{{host}}/api/admin/nodes/:node_id/files
  body: multipartForm
  auth: inherit
}

params:path {
  node_id: node
}

body:multipart-form {
  file: @file(/Users/jackson.chadfield/Downloads/scratch.txt) @contentType(text/plain)
}

settings {
  encodeUrl: true
  timeout: 0
}
