meta {
  name: Update Request Fulfilment
  type: http
  seq: 3
}

patch {
  url: {{scheme}}{{host}}/api/admin/favours/requests/:id
  body: json
  auth: inherit
}

params:path {
  id: 2
}

body:json {
  {
    "fulfilled": true
  }
}

body:form-urlencoded {
  fulfil: false
}

body:multipart-form {
  fulfil: true
}

settings {
  encodeUrl: true
  timeout: 0
}
